# ========================================================
# EduManage - Student Management System Environment Config
# ========================================================

# Option 1: SQLite (Default, Zero-configuration, Instant run)
DATABASE_URL="file:./dev.db"

# Option 2: PostgreSQL (Enterprise Production Database)
# To use PostgreSQL:
# 1. Update prisma/schema.prisma: change provider to "postgresql"
# 2. Uncomment the line below and set your credentials:
# DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/edumanage?schema=public"

# Authentication Secret
JWT_SECRET="edumanage-super-secret-key-codsoft-2026"

# Base URL
NEXTAUTH_URL="http://localhost:3000"
